# Copy to .env and fill in. Everything except the two secrets has a default.

# Required. Long random strings, e.g. `openssl rand -hex 24`.
API_TOKEN=change-me
POSTGRES_PASSWORD=change-me

# The address people open OpenChar at. Links in emails point here.
APP_URL=http://localhost:3000

# closed: only the first account can sign up; admins invite everyone else.
# open: anyone who can reach the server can create a workspace.
SIGNUP_MODE=closed

# Optional. Without a mailer, reset and invite links are written to the API
# log and shown to the admin who sent the invite. With one, OpenChar POSTs
# each message as JSON ({to, subject, text, link}) to this URL.
MAIL_WEBHOOK_URL=

# Optional. Set to 1 to email workspace admins when an instrument's
# calibration is due within 30 days or has lapsed. Needs a mailer.
CALIBRATION_ALERT_EMAILS=

# Optional. HTTPS with automatic certificates: set DOMAIN, point its DNS
# A record at this machine, then `docker compose --profile tls up -d`.
DOMAIN=

# Optional. The project shown at /public (it must also be published).
PUBLIC_PROJECT_ID=

# Optional. Isometric Certify API credentials, to submit batches for real.
ISOMETRIC_API_KEY=
ISOMETRIC_CLIENT_SECRET=
